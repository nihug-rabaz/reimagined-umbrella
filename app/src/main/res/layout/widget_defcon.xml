<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/defcon_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <View
        android:id="@+id/defcon_widget_indicator"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/defconLevel4" />

    <LinearLayout
        android:id="@+id/defcon_widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/defcon_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/defcon_widget_title"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/defcon_widget_level_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/defcon_widget_level_value_placeholder"
            android:textColor="@color/defconLevel4"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/defcon_widget_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:text="@string/defcon_widget_description_text"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/defcon_widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/defcon_widget_updated_placeholder"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/defcon_widget_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/defcon_widget_loading"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>

